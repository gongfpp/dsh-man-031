{
  "name": "dsh-man-031",
  "version": "0.7.0",
  "icon": "icon.png",
  "description": "A transparent Kobe iced-tea reminder with exact turn costs and bundled offline Doubao phrase/number audio.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "gongfpp",
  "repository": { "type": "git", "url": "git+https://github.com/gongfpp/dsh-man-031.git" },
  "homepage": "https://github.com/gongfpp/dsh-man-031#readme",
  "bugs": { "url": "https://github.com/gongfpp/dsh-man-031/issues" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "voice", "usage", "offline", "kobe"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Man！花了这么多钱！",
    "summary": "每轮结束弹出科比冰红茶人物，二十句离线台词随机播报本轮估算费用，支持人民币/美元和三位小数四舍五入。",
    "categories": ["usage", "voice"],
    "surfaces": ["host", "web"],
    "capabilities": {},
    "permissions": {},
    "compatibility": { "dsh": ">=0.2.2-0 <0.3.0-0", "node": ">=22" }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "assets/kobe.png",
    "assets/voices/manifest.json",
    "assets/voices/readable-text.txt",
    "assets/voices/clips/*.wav",
    "assets/voices/amounts/CNY-0.31.wav",
    "docs/preview.png",
    "docs/settings.png",
    "docs/SOURCES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "react": "19.2.0",
    "react-test-renderer": "19.2.0"
  },
  "scripts": {
    "test": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs && node scripts/verify-amount-voice.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.2-0 <0.3.0-0"
    }
  }
}
