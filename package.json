{
  "name": "dsh-man-031",
  "version": "0.8.1",
  "icon": "icon.png",
  "description": "A Kobe iced-tea turn reminder with cost-meter-first pricing, public-price fallback, token-only reporting and bundled offline audio.",
  "type": "module",
  "license": "MIT",
  "author": "gongfpp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongfpp/dsh-man-031.git"
  },
  "homepage": "https://github.com/gongfpp/dsh-man-031#readme",
  "bugs": {
    "url": "https://github.com/gongfpp/dsh-man-031/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "usage",
    "offline",
    "kobe"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Man！花了这么多钱！",
    "summary": "每轮结束弹出科比冰红茶人物，离线播报费用或Token用量；优先cost-meter，无则按公开单价估算。支持人民币/美元、二十句金额台词与四句Token台词。",
    "categories": [
      "usage",
      "voice"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {},
    "permissions": {},
    "compatibility": {
      "dsh": ">=0.2.2-0 <0.3.0-0",
      "node": ">=22"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "assets/kobe.png",
    "assets/provider-pricing.json",
    "lib/public-pricing.js",
    "docs/PRICING-LICENSE.txt",
    "assets/voices/manifest.json",
    "assets/voices/readable-text.txt",
    "assets/voices/clips/*.wav",
    "assets/voices/amounts/CNY-0.31.wav",
    "docs/preview.png",
    "docs/settings.png",
    "docs/SOURCES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "react": "19.2.0",
    "react-test-renderer": "19.2.0"
  },
  "scripts": {
    "test": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs && node scripts/verify-amount-voice.mjs && node scripts/test-public-pricing.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.2-0 <0.3.0-0"
    }
  }
}
