  "phrases": [
    {
      "id": "round-next",
      "labelZh": "1. 一轮结束，下一轮？",
      "labelEn": "1. One round down",
      "prefix": "prefix",
      "suffix": "line-next",
      "text": "MAN! That's about {amount} {unit}. One round down. What's next?"
    },
    {
      "id": "back-work",
      "labelZh": "2. 继续干活",
      "labelEn": "2. Back to work",
      "prefix": "about",
      "suffix": "line-work",
      "text": "About {amount} {unit}. All right. Back to work."
    },
    {
      "id": "make-count",
      "labelZh": "3. 让这笔钱花得值",
      "labelEn": "3. Make that count",
      "prefix": "man-about",
      "suffix": "line-count",
      "text": "MAN! About {amount} {unit}. Let's make that count."
    },
    {
      "id": "jobs",
      "labelZh": "4. 活儿还没结束",
      "labelEn": "4. Job's not finished",
      "prefix": "came-about",
      "suffix": "line-jobs",
      "text": "That came to about {amount} {unit}. Job's not finished."
    },
    {
      "id": "wanted",
      "labelZh": "5. 你说再来一轮？",
      "labelEn": "5. Another round?",
      "prefix": "wanted-round",
      "text": "MAN! You wanted another round. That's about {amount} {unit}."
    },
    {
      "id": "locked",
      "labelZh": "6. 保持专注",
      "labelEn": "6. Stay locked in",
      "prefix": "another-round",
      "suffix": "line-locked",
      "text": "Another round. About {amount} {unit}. Stay locked in."
    },
    {
      "id": "pass",
      "labelZh": "7. 传球，不是传账单",
      "labelEn": "7. Pass the ball, not the bill",
      "prefix": "pass-bill",
      "text": "MAN! I said pass the ball. Not the bill. About {amount} {unit}."
    },
    {
      "id": "breath",
      "labelZh": "8. 喘口气，再投下一球",
      "labelEn": "8. Take the next shot",
      "prefix": "about",
      "suffix": "line-breath",
      "text": "About {amount} {unit}. Take a breath. Then take the next shot."
    },
    {
      "id": "going",
      "labelZh": "9. 还能说什么？继续吧",
      "labelEn": "9. We keep going",
      "prefix": "what-say",
      "suffix": "line-going",
      "text": "What can I say? About {amount} {unit}. We keep going."
    },
    {
      "id": "out",
      "labelZh": "10. 这轮结束，曼巴退场",
      "labelEn": "10. Mamba out",
      "prefix": "man-about",
      "suffix": "line-out",
      "text": "MAN! About {amount} {unit}. This round's over. Mamba out."
    },
    {
      "id": "next-play",
      "labelZh": "11. 别找借口，下一回合",
      "labelEn": "11. No excuses, next play",
      "prefix": "man-about",
      "suffix": "line-next-play",
      "text": "MAN! About {amount} {unit}. No excuses. Next play."
    },
    {
      "id": "far-stop",
      "labelZh": "12. 走到这了，别停",
      "labelEn": "12. We did not come this far to stop",
      "prefix": "about",
      "suffix": "line-far-stop",
      "text": "About {amount} {unit}. We didn't come this far to stop."
    },
    {
      "id": "showed",
      "labelZh": "13. 账单来了，我们也到了",
      "labelEn": "13. The bill showed up",
      "prefix": "bill-showed",
      "text": "MAN! The bill showed up. So did we. About {amount} {unit}."
    },
    {
      "id": "worth",
      "labelZh": "14. 现在，让这笔钱花得值",
      "labelEn": "14. Make it worth it",
      "prefix": "about",
      "suffix": "line-worth",
      "text": "About {amount} {unit}. Good. Now make it worth it."
    },
    {
      "id": "eyes",
      "labelZh": "15. 抬头，下一球",
      "labelEn": "15. Eyes up, next shot",
      "prefix": "man-about",
      "suffix": "line-eyes",
      "text": "MAN! About {amount} {unit}. Eyes up. Next shot."
    },
    {
      "id": "rep",
      "labelZh": "16. 再练一组",
      "labelEn": "16. One more rep",
      "prefix": "about",
      "suffix": "line-rep",
      "text": "About {amount} {unit}. One more rep."
    },
    {
      "id": "receipt",
      "labelZh": "17. 留着小票，丢掉怀疑",
      "labelEn": "17. Keep the receipt, lose the doubt",
      "prefix": "about",
      "suffix": "line-receipt",
      "text": "About {amount} {unit}. Keep the receipt. Lose the doubt."
    },
    {
      "id": "shortcuts",
      "labelZh": "18. 这里没有捷径",
      "labelEn": "18. No shortcuts from here",
      "prefix": "man-about",
      "suffix": "line-shortcuts",
      "text": "MAN! About {amount} {unit}. No shortcuts from here."
    },
    {
      "id": "mission",
      "labelZh": "19. 再来一轮，目标不变",
      "labelEn": "19. Same mission",
      "prefix": "another-round",
      "suffix": "line-mission",
      "text": "Another round, about {amount} {unit}. Same mission."
    },
    {
      "id": "clock",
      "labelZh": "20. 计时还没停",
      "labelEn": "20. Clock is still running",
      "prefix": "about",
      "suffix": "line-clock",
      "text": "About {amount} {unit}. Clock's still running."
    }
  ],
